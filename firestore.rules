rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collectionId}/{entryId} {
      allow read, write: if request.auth != null && collectionId.matches('.*Entries$');
    }
    match /meta/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
